# ==============================================================================
# KAVANDOR Intelligent Harvest & Supply Network — Environment Configuration
# ==============================================================================
# Copy this file to .env.local to configure live external providers:
#   cp .env.example .env.local
#
# If keys are omitted or left blank, KAVANDOR automatically operates in
# Hybrid Dual-Mode with deterministic domain rules and in-memory persistence.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Google Gemini AI (Multimodal Quality & Agronomic Triage)
# ------------------------------------------------------------------------------
# Obtain from Google AI Studio: https://aistudio.google.com/
AI_PROVIDER_API_KEY=

# ------------------------------------------------------------------------------
# 2. Supabase PostgreSQL & Auth (Database & RLS)
# ------------------------------------------------------------------------------
# Obtain from your Supabase Dashboard -> Project Settings -> API
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# ------------------------------------------------------------------------------
# 3. Application Site URL
# ------------------------------------------------------------------------------
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ------------------------------------------------------------------------------
# 4. Optional Social Authentication (Google & Facebook)
# ------------------------------------------------------------------------------
NEXT_PUBLIC_GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

NEXT_PUBLIC_FACEBOOK_APP_ID=
FACEBOOK_CLIENT_SECRET=
